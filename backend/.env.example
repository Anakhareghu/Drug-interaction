# Drug Interaction Analysis Platform — Backend Environment Configuration Example
# Copy this file to .env and customize secrets for deployment

# Security & Secrets (NEVER commit production secrets to Git)
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial Admin User Credentials
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
AUTH_EMAIL=lead.pharmacologist@internal.lab
AUTH_ROLE=Lead Pharmacologist
