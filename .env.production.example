# Production Environment Configuration Template
# COPY THIS FILE TO '.env' ON YOUR PRODUCTION DEPLOYMENT SERVER AND CUSTOMIZE SECRETS

# ------------------------------------------------------------------------------
# 1. SECURITY & JWT AUTHENTICATION (CRITICAL FOR PRODUCTION)
# ------------------------------------------------------------------------------
# WARNING: Generate a cryptographically strong secret key before starting containers.
# Example Linux/macOS generation command: openssl rand -hex 32
JWT_SECRET_KEY=e8f92a401b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ------------------------------------------------------------------------------
# 2. INITIAL PLATFORM CREDENTIALS
# ------------------------------------------------------------------------------
# WARNING: Do NOT use default 'admin123' in public deployments!
AUTH_USERNAME=lead_pharmacologist
AUTH_PASSWORD=SetAStrongRandomPassword2026!
AUTH_EMAIL=pharmacology.lead@lab.internal
AUTH_ROLE=Lead Pharmacologist

# ------------------------------------------------------------------------------
# 3. CORS & DOMAIN WHITELIST
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins that can access the API
CORS_ORIGINS=https://drug-interaction.internal.lab,https://localhost,http://localhost:80,http://localhost

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_URL=/api
